# ---------------------------------------------------------------------------
# Aiven PostgreSQL — add these to backend/.env (which is gitignored).
# Copy the "Service URI" from the Aiven console; do not paste it into a chat.
# ---------------------------------------------------------------------------

# Looks like: postgres://avnadmin:PASSWORD@pg-xxxx.aivencloud.com:12345/defaultdb?sslmode=require
# Both postgres:// and postgresql:// work — the driver prefix and Aiven's
# ?sslmode=require are normalised automatically in app/db/base.py.
DATABASE_URL=

# Signs session tokens. MUST be at least 32 bytes in production; the app refuses
# to start otherwise. Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# How long a session lasts.
JWT_EXPIRES_HOURS=72

# Municipal officials, comma-separated. Either a whole address
# (engineer@ghmc.gov.in) or a domain suffix (@ghmc.gov.in). Anyone not listed
# signs up as a citizen; there is no way to request the role from the app.
# Re-checked at every login, so adding an address here promotes that account
# the next time it signs in.
OFFICIAL_EMAILS=
