# --- Secrets ---------------------------------------------------------------
.env
.env.*
!.env.example
# The Aiven template is a template - it holds variable NAMES and comments, no
# values. Without this exception `.env.*` swallows it and a fresh clone has no
# guide for DATABASE_URL, JWT_SECRET or OFFICIAL_EMAILS. `git add` on an
# ignored path fails silently, so this was invisible until someone cloned.
!.env.aiven.example

# --- Model weights ---------------------------------------------------------
# best.pt is usually far too large for Git. Ship it with Git LFS or download
# it at build time; see README.md.
weights/*.pt
weights/*.onnx
!weights/.gitkeep
# YOLO11n best.pt is ~5.5 MB - small enough to commit, and Render deploys
# the model straight from the repo. Without this exception the API would
# silently fall back to the generic COCO model in production.
!weights/best.pt

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Ultralytics scratch ---------------------------------------------------
runs/
*.pt.lock
yolov8*.pt
yolo11*.pt

# --- OS / editor -----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Local scratch ---------------------------------------------------------
tmp/
outputs/
