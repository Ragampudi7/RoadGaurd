# ---------------------------------------------------------------------------
# Copy this file to .env and adjust. NEVER commit .env - it is gitignored.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- YOLO model ------------------------------------------------------------
# Path to your trained road-defect weights, relative to the backend/ folder.
MODEL_PATH=weights/best.pt

# If MODEL_PATH does not exist, may the server fall back to a generic
# pretrained model so the API stays usable while you finish training?
# TRUE  -> API works immediately, but detections are COCO objects (person,
#          car, ...), NOT road defects. Every response and PDF is clearly
#          marked as demonstration output.
# FALSE -> /analyze returns 503 until best.pt exists.
# Set this to false once your real model is in place.
ALLOW_PRETRAINED_FALLBACK=true
FALLBACK_MODEL_NAME=yolov8n.pt

CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45
MAX_DETECTIONS=100
INFERENCE_IMAGE_SIZE=640

# --- Upload limits ---------------------------------------------------------
MAX_IMAGE_SIZE_MB=10
MIN_IMAGE_DIMENSION=64
MAX_IMAGE_DIMENSION=8000
MAX_ANNOTATED_DIMENSION=1280
ANNOTATED_JPEG_QUALITY=82

# --- Scoring ---------------------------------------------------------------
# sum   = add every bounding-box area (project specification, overlaps counted twice)
# union = count each damaged pixel once (overlap-corrected)
AREA_METHOD=sum

# --- Road-risk model -------------------------------------------------------
# Each component scores 0-100 = measured value / full scale. Weights are
# normalised, so only their ratio matters. All project-defined; see README.
RISK_EXTENT_FULL_SCALE=25.0
RISK_SEVERITY_FULL_SCALE=10.0
RISK_DENSITY_FULL_SCALE=8
RISK_WEIGHT_EXTENT=0.50
RISK_WEIGHT_SEVERITY=0.30
RISK_WEIGHT_DENSITY=0.20

# --- Report extras ---------------------------------------------------------
INCLUDE_DEFECT_CROPS=true
MAX_DEFECT_CROPS=6
CROP_THUMBNAIL_SIDE=360

# --- CORS ------------------------------------------------------------------
# Where your frontend runs. Add Vercel preview URLs to EXTRA_CORS_ORIGINS.
FRONTEND_URL=http://localhost:3000
EXTRA_CORS_ORIGINS=

# --- Report wording --------------------------------------------------------
MUNICIPAL_AUTHORITY=Greater Hyderabad Municipal Corporation (GHMC)
ENGINEERING_WING=Roads & Maintenance Division
COMPLAINT_REGION=Hyderabad, Telangana, India
REPORT_TIMEZONE_OFFSET_MINUTES=330

# --- Performance -----------------------------------------------------------
MAX_CONCURRENT_INFERENCES=1
