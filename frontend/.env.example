# Backend base URL. Read at BUILD time by Vite, so Render needs it set before
# the build step, not at runtime.
VITE_API_BASE=http://localhost:8000

# Demo mode. "true" (default) serves fixed sample data from src/lib/mockData.js
# and marks it in the UI. Set to false to call the real POST /analyze.
VITE_USE_MOCK=true
